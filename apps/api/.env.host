# Host Mode Configuration (Development)
NODE_ENV=development
PORT=3000

# Database (PostgreSQL in Docker, exposed on 5433)
DATABASE_URL=postgresql://nextsafar:password@localhost:5433/nextsafar_core?schema=public

# Redis (in Docker, exposed on 6380)
REDIS_HOST=localhost
REDIS_PORT=6380

# JWT
JWT_SECRET=super-secret-nextsafar-key-change-in-production
JWT_REFRESH_SECRET=super-secret-refresh-key-change-in-production

# WordPress
WP_WEBHOOK_SECRET=super-secret-wp-key-123

# Internal API
CORE_API_URL=http://localhost:3000
INTERNAL_API_SECRET=internal-secret-key

# MinIO (disabled in host mode)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=dummy
MINIO_SECRET_KEY=dummy
MINIO_USE_SSL=false
MINIO_ENABLED=false

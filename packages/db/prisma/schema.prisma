generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. USERS & AUTH MODULE
// ==========================================
model User {
  id           String    @id @default(uuid())
  firstName    String?
  lastName     String?
  mobile       String    @unique
  email        String?   @unique
  passwordHash String
  isActive     Boolean   @default(true)
  language     String    @default("fa")
  currency     String    @default("IRR")
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  roles        UserRole[]
  refreshTokens RefreshToken[]
  auditLogs    AuditLog[]
  orders       Order[]
  transactions Transaction[]
  visaCases    VisaCase[]
  notifications Notification[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  userAgent String?
  ip        String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

// ==========================================
// 2. RBAC (ROLES & PERMISSIONS)
// ==========================================
model Role {
  id          String   @id @default(uuid())
  name        String   @unique 
  displayName String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id        String   @id @default(uuid())
  name      String   @unique 
  module    String
  createdAt DateTime @default(now())
  roles     RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@id([roleId, permissionId])
}

model UserRole {
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  @@id([userId, roleId])
}

// ==========================================
// 3. SYSTEM & AUDIT MODULE
// ==========================================
model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  type      String   
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String   
  entityType String?  
  entityId   String?
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([entityType, entityId])
  @@index([userId])
  @@index([action])
}

// ==========================================
// 4. HOTELS MODULE
// ==========================================
enum HotelPublishStatus {
  DRAFT
  PUBLISHED
  INACTIVE
  PENDING_REVIEW
  REMOVED_FROM_WORDPRESS
  NEEDS_UPDATE
}

model Hotel {
  id               String             @id @default(uuid())
  wpPostId         Int?               @unique
  slug             String             @unique
  name             String
  nameEn           String?
  city             String?
  country          String?
  countryCode      String?
  address          String?
  publishStatus    HotelPublishStatus @default(DRAFT)
  displayStatus    Boolean            @default(true)
  syncStatus       String?
  source           String?
  shortDescription String?
  fullContent      String?
  instructions     String?
  stars            Int?
  rating           Float?
  reviewsCount     Int?
  staffPoint       Float?
  facilitiesPoint  Float?
  cleanlinessPoint Float?
  comfortPoint     Float?
  servicesPoint    Float?
  locationPoint    Float?
  reviewsHistogram Json?
  reviewsBreakdown Json?
  featuredImage    String?
  galleryImages    Json?
  amenities        Json?
  amenitiesCount   Int?
  coordinates      Json?
  nearbyPlaces     Json?
  price            Float?
  priceFormatted   String?
  currency         String?
  bookingLink      String?
  checkinTime      String?
  checkoutTime     String?
  checkinPolicy    String?
  checkoutPolicy   String?
  expensesPolicy   String?
  ageRestriction   String?
  petsPolicy       String?
  seoTitle         String?
  seoDescription   String?
  seoImage         String?
  focusKeyword     String?
  ogImage          String?
  canonical        String?
  acfFields        Json?
  hotelType        String?
  propertyToken    String?
  externalId       String?
  faq              Json?
  tags             String[]
  categories       String[]
  mediaSyncStatus  String?
  lastMediaSyncAt  DateTime?
  contentVersion   Int                @default(1)
  lastSyncedAt     DateTime?
  wpLastModified   DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  slugs            HotelSlug[]
  providerMappings HotelProviderMapping[]
  tourRelations    TourHotelRelation[]
  @@index([city])
  @@index([country])
  @@index([stars])
  @@index([rating])
  @@index([publishStatus])
}

model HotelSlug {
  id        String   @id @default(uuid())
  slug      String   @unique
  hotelId   String
  hotel     Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model HotelProviderMapping {
  id              String    @id @default(uuid())
  hotelId         String
  providerName    String
  providerHotelId String
  isActive        Boolean   @default(true)
  lastSyncedAt    DateTime?
  priority        Int       @default(0)
  hotel           Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  @@unique([hotelId, providerName])
}

// ==========================================
// 5. SYNC LOGS MODULE
// ==========================================
model SyncLog {
  id             String    @id @default(uuid())
  wpPostId       Int
  eventType      String   
  status         String   
  errorMessage   String?
  contentVersion Int?
  attemptCount   Int       @default(1)
  receivedAt     DateTime  @default(now())
  processedAt    DateTime?
  @@index([wpPostId])
  @@index([status])
}

// ==========================================
// 6. TOURS MODULE
// ==========================================
enum TourStatus {
  DRAFT
  READY
  PUBLISHED
  SELLING
  SOLD_OUT
  EXPIRED
  CANCELLED
  INACTIVE
}

model TourCategory {
  id    String @id @default(uuid())
  name  String @unique
  slug  String @unique
  tours Tour[]
}

model TourDestination {
  id    String @id @default(uuid())
  name  String @unique
  slug  String @unique
  tours Tour[]
}

model Tour {
  id             String     @id @default(uuid())
  title          String
  slug           String     @unique
  description    String?
  categoryId     String?
  destinationId  String?
  status         TourStatus @default(DRAFT)
  durationDays   Int?
  durationNights Int?
  transportType  String?
  images         Json?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  category       TourCategory?    @relation(fields: [categoryId], references: [id])
  destination    TourDestination? @relation(fields: [destinationId], references: [id])
  dates          TourDate[]
  itineraries    TourItinerary[]
  services       TourService[]
  hotelRelations TourHotelRelation[]
  leads          Lead[]
}

model TourDate {
  id                String    @id @default(uuid())
  tourId            String
  startDate         DateTime
  endDate           DateTime
  totalCapacity     Int
  remainingCapacity Int
  adultPrice        Float
  childPrice        Float
  infantPrice       Float
  singlePrice       Float?
  status            String    @default("ACTIVE")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  tour              Tour      @relation(fields: [tourId], references: [id], onDelete: Cascade)
  @@index([tourId, startDate])
}

model TourItinerary {
  id          String   @id @default(uuid())
  tourId      String
  dayNumber   Int
  title       String
  description String
  order       Int      @default(0)
  tour        Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)
  @@index([tourId, dayNumber])
}

model TourService {
  id          String   @id @default(uuid())
  tourId      String
  name        String
  description String?
  isIncluded  Boolean  @default(true)
  tour        Tour     @relation(fields: [tourId], references: [id], onDelete: Cascade)
}

model TourHotelRelation {
  id           String @id @default(uuid())
  tourId       String
  hotelId      String
  relationType String @default("MAIN") 
  priority     Int    @default(0)
  notes        String?
  tour         Tour   @relation(fields: [tourId], references: [id], onDelete: Cascade)
  hotel        Hotel  @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  @@unique([tourId, hotelId])
}

model Lead {
  id               String   @id @default(uuid())
  leadType         String   
  customerName     String?
  phone            String?
  email            String?
  relatedTourId    String?
  relatedHotelId   String?
  preferredDate    DateTime?
  passengerCount   Int?
  message          String?
  source           String?
  status           String   @default("NEW") 
  assignedAgentId  String?
  nextFollowupDate DateTime?
  notes            Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  tour             Tour?    @relation(fields: [relatedTourId], references: [id], onDelete: SetNull)
  @@index([status])
  @@index([relatedTourId])
}

// ==========================================
// 7. ORDERS & PAYMENTS MODULE
// ==========================================
enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  BOOKING_REQUESTED
  ISSUED
  FAILED
  NEEDS_REVIEW
  CANCELLED
  REFUND_REQUESTED
  REFUNDED
}

enum PaymentStatus {
  INITIATED
  PENDING_GATEWAY
  SUCCESSFUL
  FAILED
  EXPIRED
  REVERSED
  RECONCILIATION_NEEDED
  CANCELLED
}

enum TransactionType {
  DEBIT
  CREDIT
  REFUND
  ADJUSTMENT
}

enum ReconciliationStatus {
  PENDING
  RECONCILED
  DISCREPANCY
}

model Order {
  id               String      @id @default(uuid())
  orderNumber      String      @unique
  userId           String
  status           OrderStatus @default(DRAFT)
  totalAmount      Float
  currency         String      @default("IRR")
  discountAmount   Float       @default(0)
  finalAmount      Float
  idempotencyKey   String?     @unique
  source           String?
  notes            String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  user             User        @relation(fields: [userId], references: [id])
  items            OrderItem[]
  passengers       OrderPassenger[]
  payments         Payment[]
  statusHistory    OrderStatusHistory[]
  transactions     Transaction[]
  @@index([userId])
  @@index([status])
}

model OrderItem {
  id          String @id @default(uuid())
  orderId     String
  itemType    String
  itemId      String
  itemName    String
  quantity    Int
  unitPrice   Float
  totalPrice  Float
  order       Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  @@index([orderId])
}

model OrderPassenger {
  id             String    @id @default(uuid())
  orderId        String
  firstName      String
  lastName       String
  nationalId     String?
  passportNumber String?
  birthDate      DateTime?
  gender         String?
  relationship   String?
  order          Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  @@index([orderId])
}

model Payment {
  id               String        @id @default(uuid())
  orderId          String
  amount           Float
  currency         String        @default("IRR")
  status           PaymentStatus @default(INITIATED)
  gatewayName      String?
  gatewayRefId     String?
  gatewayTrackId   String?
  gatewayMessage   String?
  paidAt           DateTime?
  idempotencyKey   String?       @unique
  metadata         Json?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  order            Order         @relation(fields: [orderId], references: [id])
  transactions     Transaction[]
  @@index([orderId])
  @@index([gatewayRefId])
}

model Transaction {
  id                   String               @id @default(uuid())
  type                 TransactionType
  amount               Float
  currency             String               @default("IRR")
  userId               String
  orderId              String?
  paymentId            String?
  reason               String
  reference            String?
  reconciliationStatus ReconciliationStatus @default(PENDING)
  createdAt            DateTime             @default(now())
  user                 User                 @relation(fields: [userId], references: [id])
  order                Order?               @relation(fields: [orderId], references: [id])
  payment              Payment?             @relation(fields: [paymentId], references: [id])
  @@index([userId])
  @@index([orderId])
  @@index([paymentId])
}

model OrderStatusHistory {
  id        String   @id @default(uuid())
  orderId   String
  oldStatus String?
  newStatus String
  changedBy String?
  reason    String?
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  @@index([orderId])
}

// ==========================================
// 8. VISA MODULE
// ==========================================
enum VisaCaseStatus {
  INITIAL
  DOCUMENTS_INCOMPLETE
  DOCUMENTS_COMPLETE
  UNDER_REVIEW
  APPOINTMENT_NEEDED
  APPOINTMENT_DONE
  SUBMITTED
  IN_PROCESS
  BIOMETRICS_DONE
  APPROVED
  REJECTED
  NEEDS_CORRECTION
  COMPLETED
  CANCELLED
}

model VisaType {
  id               String   @id @default(uuid())
  wpPostId         Int?     @unique
  slug             String   @unique
  title            String
  shortDescription String?
  fullContent      String?
  basePrice        Float?
  currency         String   @default("USD")
  prices           Json?
  processingDays   Int?
  validityDays     Int?
  issueTime        String?
  expiryTime       String?
  entryType        String?
  visaType         String?
  requiredDocuments Json?
  bannerImage      String?
  featuredImage    String?
  gallery          Json?
  seoTitle         String?
  seoDescription   String?
  focusKeyword     String?
  isActive         Boolean  @default(true)
  syncStatus       String   @default("SYNCED")
  lastSyncedAt     DateTime?
  contentVersion   Int      @default(1)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  visaCases        VisaCase[]
  visaChecklists   VisaChecklist[]
  @@index([isActive])
  @@index([visaType])
}

model VisaCountry {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String   @unique
  description String?
  processingTime String?
  fee         Float?
  currency    String   @default("USD")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  checklists  VisaChecklist[]
  cases       VisaCase[]
}

model VisaChecklist {
  id          String   @id @default(uuid())
  countryId   String?
  visaTypeId  String?
  name        String
  description String?
  isRequired  Boolean  @default(true)
  order       Int      @default(0)
  country     VisaCountry? @relation(fields: [countryId], references: [id], onDelete: Cascade)
  visaType    VisaType?    @relation(fields: [visaTypeId], references: [id], onDelete: Cascade)
  @@index([countryId])
  @@index([visaTypeId])
}

model VisaCase {
  id              String         @id @default(uuid())
  userId          String
  countryId       String?
  visaTypeId      String?
  caseNumber      String         @unique
  status          VisaCaseStatus @default(INITIAL)
  applicantName   String
  applicantPassport String?
  travelDate      DateTime?
  visaCategory    String?
  notes           String?
  assignedAgentId String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  user            User           @relation(fields: [userId], references: [id])
  country         VisaCountry?   @relation(fields: [countryId], references: [id])
  visaType        VisaType?      @relation(fields: [visaTypeId], references: [id])
  documents       VisaCaseDocument[]
  appointments    VisaAppointment[]
  timeline        VisaCaseTimeline[]
  @@index([userId])
  @@index([status])
  @@index([countryId])
  @@index([visaTypeId])
}

model VisaCaseDocument {
  id          String   @id @default(uuid())
  caseId      String
  fileName    String
  fileUrl     String
  fileSize    Int
  mimeType    String
  isVerified  Boolean  @default(false)
  verifiedBy  String?
  verifiedAt  DateTime?
  notes       String?
  uploadedAt  DateTime @default(now())
  case        VisaCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  @@index([caseId])
}

model VisaAppointment {
  id              String    @id @default(uuid())
  caseId          String
  appointmentDate DateTime
  location        String?
  referenceNumber String?
  status          String    @default("SCHEDULED")
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  case            VisaCase  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  @@index([caseId])
}

model VisaCaseTimeline {
  id          String   @id @default(uuid())
  caseId      String
  action      String
  oldStatus   String?
  newStatus   String?
  description String?
  changedBy   String?
  metadata    Json?
  createdAt   DateTime @default(now())
  case        VisaCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  @@index([caseId])
}

// ==========================================
// 9. NOTIFICATIONS MODULE
// ==========================================
enum NotificationChannel {
  SMS
  EMAIL
  INTERNAL
  WHATSAPP
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
}

model Notification {
  id          String              @id @default(uuid())
  userId      String?
  channel     NotificationChannel
  recipient   String
  subject     String?
  template    String
  data        Json?
  status      NotificationStatus  @default(PENDING)
  attempts    Int                 @default(0)
  errorMessage String?
  sentAt      DateTime?
  createdAt   DateTime            @default(now())
  user        User?               @relation(fields: [userId], references: [id])
  @@index([userId])
  @@index([status])
  @@index([channel])
}

model AdminActivityLog {
  id         String   @id @default(uuid())
  adminId    String
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())
  @@index([adminId])
  @@index([action])
  @@index([createdAt])
}

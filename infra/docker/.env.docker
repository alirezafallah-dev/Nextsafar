# ============================================
# Environment: Production Docker
# ============================================

# Application
NODE_ENV=production

# PostgreSQL
POSTGRES_USER=nextsafar
POSTGRES_PASSWORD=change-this-strong-password-123
POSTGRES_DB=nextsafar_core
POSTGRES_PORT=5433

# Redis
REDIS_PORT=6380

# MinIO (Object Storage)
MINIO_ACCESS_KEY=nextsafar-minio-admin
MINIO_SECRET_KEY=change-this-minio-password-456
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# API Ports
API_PORT=3000
SEARCH_PORT=3001
NGINX_PORT=80

# Security (CHANGE THESE IN PRODUCTION!)
JWT_SECRET=replace-with-very-long-random-string-1
JWT_REFRESH_SECRET=replace-with-very-long-random-string-2
WP_WEBHOOK_SECRET=replace-with-wp-webhook-secret-3
INTERNAL_API_SECRET=replace-with-internal-secret-4

services:
  postgres:
    image: postgres:16-alpine
    container_name: nextsafar_postgres
    restart: unless-stopped
    environment:
      POSTGRES_USER: nextsafar
      POSTGRES_PASSWORD: password
      POSTGRES_DB: nextsafar_core
    ports:
      - "5433:5432"
    volumes:
      - postgres_data:/var/lib/postgresql/data
    networks:
      - nextsafar_network
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U nextsafar -d nextsafar_core"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 10s

  redis:
    image: redis:7-alpine
    container_name: nextsafar_redis
    restart: unless-stopped
    command: redis-server --appendonly yes --maxmemory 256mb --maxmemory-policy noeviction
    ports:
      - "6380:6379"
    volumes:
      - redis_data:/data
    networks:
      - nextsafar_network
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 3s
      retries: 5

  api:
    image: nextsafar-api:latest
    container_name: nextsafar_api
    restart: unless-stopped
    environment:
      NODE_ENV: production
      PORT: 3000
      DATABASE_URL: postgresql://nextsafar:password@postgres:5432/nextsafar_core?schema=public
      REDIS_HOST: redis
      REDIS_PORT: 6379
      JWT_SECRET: super-secret-nextsafar-key-change-in-production
      JWT_REFRESH_SECRET: super-secret-refresh-key-change-in-production
      WP_WEBHOOK_SECRET: super-secret-wp-key-123
      MINIO_ENDPOINT: localhost
      MINIO_PORT: 9000
      MINIO_ACCESS_KEY: dummy
      MINIO_SECRET_KEY: dummy
      CORE_API_URL: http://api:3000
      INTERNAL_API_SECRET: internal-secret-key
    ports:
      - "3000:3000"
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy
    networks:
      - nextsafar_network
    healthcheck:
      test: ["CMD", "node", "-e", "require('http').get('http://localhost:3000/api/v1/auth/login', (r) => {process.exit(r.statusCode === 404 || r.statusCode === 200 ? 0 : 1)})"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 60s

  search:
    image: nextsafar-search:latest
    container_name: nextsafar_search
    restart: unless-stopped
    environment:
      NODE_ENV: production
      SEARCH_PORT: 3001
      REDIS_HOST: redis
      REDIS_PORT: 6379
      CORE_API_URL: http://api:3000
      INTERNAL_API_SECRET: internal-secret-key
      TOUR_CACHE_TTL: 1800
      HOTEL_CACHE_TTL: 1800
      SEARCH_CACHE_TTL: 300
    ports:
      - "3001:3001"
    depends_on:
      redis:
        condition: service_healthy
      api:
        condition: service_healthy
    networks:
      - nextsafar_network
    healthcheck:
      test: ["CMD", "wget", "--no-verbose", "--tries=1", "--spider", "http://localhost:3001/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 30s

  nginx:
    image: nginx:alpine
    container_name: nextsafar_nginx
    restart: unless-stopped
    ports:
      - "80:80"
    volumes:
      - ./infra/docker/nginx/nginx.conf:/etc/nginx/conf.d/default.conf:ro
    depends_on:
      - api
      - search
    networks:
      - nextsafar_network
    healthcheck:
      test: ["CMD", "wget", "--no-verbose", "--tries=1", "--spider", "http://localhost/nginx-health"]
      interval: 30s
      timeout: 10s
      retries: 3

volumes:
  postgres_data:
    driver: local
  redis_data:
    driver: local

networks:
  nextsafar_network:
    driver: bridge
    name: nextsafar_network

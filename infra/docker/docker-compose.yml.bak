
services:
  # ==========================================
  # PostgreSQL Database
  # ==========================================
  postgres:
    image: postgres:16-alpine
    container_name: nextsafar_postgres
    restart: unless-stopped
    environment:
      POSTGRES_USER: ${POSTGRES_USER:-nextsafar}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:-password}
      POSTGRES_DB: ${POSTGRES_DB:-nextsafar_core}
    ports:
      - "${POSTGRES_PORT:-5433}:5432"
    volumes:
      - postgres_data:/var/lib/postgresql/data
    networks:
      - nextsafar_network
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER:-nextsafar} -d ${POSTGRES_DB:-nextsafar_core}"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 10s

  # ==========================================
  # Redis (Cache + Queue)
  # ==========================================
  redis:
    image: redis:7-alpine
    container_name: nextsafar_redis
    restart: unless-stopped
    command: redis-server --appendonly yes --maxmemory 256mb --maxmemory-policy allkeys-lru
    ports:
      - "${REDIS_PORT:-6380}:6379"
    volumes:
      - redis_data:/data
    networks:
      - nextsafar_network
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 3s
      retries: 5

  # ==========================================
  # MinIO (S3-compatible Object Storage)
  # ==========================================
  minio:
    image: minio/minio
    container_name: nextsafar_minio
    restart: unless-stopped
    environment:
      MINIO_ROOT_USER: ${MINIO_ACCESS_KEY:-minioadmin}
      MINIO_ROOT_PASSWORD: ${MINIO_SECRET_KEY:-minioadmin}
    ports:
      - "${MINIO_PORT:-9000}:9000"
      - "${MINIO_CONSOLE_PORT:-9001}:9001"
    command: server /data --console-address ":9001"
    volumes:
      - minio_data:/data
    networks:
      - nextsafar_network
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:9000/minio/health/live"]
      interval: 30s
      timeout: 20s
      retries: 3

  # ==========================================
  # Node.js Core API (NestJS)
  # ==========================================
  api:
    image: nextsafar-api
    container_name: nextsafar_api
    restart: unless-stopped
    environment:
      NODE_ENV: ${NODE_ENV:-production}
      PORT: 3000
      DATABASE_URL: postgresql://${POSTGRES_USER:-nextsafar}:${POSTGRES_PASSWORD:-password}@postgres:5432/${POSTGRES_DB:-nextsafar_core}?schema=public
      REDIS_HOST: redis
      REDIS_PORT: 6379
      JWT_SECRET: ${JWT_SECRET:-super-secret-nextsafar-key-change-in-production}
      JWT_REFRESH_SECRET: ${JWT_REFRESH_SECRET:-super-secret-refresh-key-change-in-production}
      WP_WEBHOOK_SECRET: ${WP_WEBHOOK_SECRET:-super-secret-wp-key-123}
      MINIO_ENDPOINT: minio
      MINIO_PORT: 9000
      MINIO_ACCESS_KEY: ${MINIO_ACCESS_KEY:-minioadmin}
      MINIO_SECRET_KEY: ${MINIO_SECRET_KEY:-minioadmin}
      CORE_API_URL: http://api:3000
      INTERNAL_API_SECRET: ${INTERNAL_API_SECRET:-internal-secret-key}
    ports:
      - "${API_PORT:-3000}:3000"
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy
      minio:
        condition: service_started
    networks:
      - nextsafar_network
    healthcheck:
      test: ["CMD", "node", "-e", "require('http').get('http://localhost:3000/api/v1/auth/login', (r) => {process.exit(r.statusCode === 404 || r.statusCode === 200 ? 0 : 1)})"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s

  # ==========================================
  # Search Service (Fastify)
  # ==========================================
  search:
    image: nextsafar-search
    container_name: nextsafar_search
    restart: unless-stopped
    environment:
      NODE_ENV: ${NODE_ENV:-production}
      SEARCH_PORT: 3001
      REDIS_HOST: redis
      REDIS_PORT: 6379
      CORE_API_URL: http://api:3000
      INTERNAL_API_SECRET: ${INTERNAL_API_SECRET:-internal-secret-key}
      TOUR_CACHE_TTL: 1800
      HOTEL_CACHE_TTL: 1800
      SEARCH_CACHE_TTL: 300
    ports:
      - "${SEARCH_PORT:-3001}:3001"
    depends_on:
      redis:
        condition: service_healthy
      api:
        condition: service_healthy
    networks:
      - nextsafar_network
    healthcheck:
      test: ["CMD", "wget", "--no-verbose", "--tries=1", "--spider", "http://localhost:3001/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 30s

  # ==========================================
  # Nginx Reverse Proxy
  # ==========================================
  nginx:
    image: nginx:alpine
    container_name: nextsafar_nginx
    restart: unless-stopped
    ports:
      - "${NGINX_PORT:-80}:80"
    volumes:
      - ./nginx/nginx.conf:/etc/nginx/conf.d/default.conf:ro
    depends_on:
      - api
      - search
    networks:
      - nextsafar_network
    healthcheck:
      test: ["CMD", "wget", "--no-verbose", "--tries=1", "--spider", "http://localhost/nginx-health"]
      interval: 30s
      timeout: 10s
      retries: 3

# ==========================================
# Volumes
# ==========================================
volumes:
  postgres_data:
    driver: local
  redis_data:
    driver: local
  minio_data:
    driver: local

# ==========================================
# Networks
# ==========================================
networks:
  nextsafar_network:
    driver: bridge
    name: nextsafar_network
